<Project>
    <PropertyGroup>
        <!-- فعال‌سازی مدیریت متمرکز پکیج‌ها -->
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- ===== پکیج‌های پایه و مشترک ===== -->
        <PackageVersion Include="MailKit" Version="4.16.0" />
        <PackageVersion Include="MediatR" Version="14.1.0" />
        <PackageVersion Include="AutoMapper" Version="16.1.1" />
        <PackageVersion Include="FluentValidation" Version="12.1.1" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
        <PackageVersion Include="MimeKit" Version="4.16.0" />
        <PackageVersion Include="Polly" Version="8.6.6" />
        <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
        <PackageVersion Include="MassTransit.RabbitMQ" Version="9.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.7" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.7" />

        <!-- ===== ASP.NET Core و Identity ===== -->
        <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.7" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
        <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.7" />
        <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.7" />
        <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.7" />
        <!-- ===== EF Core و دیتابیس ===== -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.7" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.7" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
        <!-- ===== OpenAPI و مستندات ===== -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
        <PackageVersion Include="Scalar.AspNetCore" Version="2.14.4" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.1.7" />
        <!-- ===== API Versioning ===== -->
        <PackageVersion Include="Asp.Versioning.Mvc" Version="10.0.0" />
        <!-- ===== Dapper و سایر ابزارها ===== -->
        <PackageVersion Include="Dapper" Version="2.1.72" />
        <PackageVersion Include="RabbitMQ.Client" Version="6.8.1" />
        <!-- ===== پکیج‌های تست (جدید - برای رفع خطا) ===== -->
        <PackageVersion Include="coverlet.collector" Version="6.0.4" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageVersion Include="FluentAssertions" Version="8.9.0" />
        <PackageVersion Include="MediatR.Extensions.Microsoft.DependencyInjection" Version="11.1.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Moq.EntityFrameworkCore" Version="10.0.0.2" />
        <PackageVersion Include="NSubstitute" Version="5.3.0" />
        <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
        <!-- =====  Logging  ===== -->
        <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageVersion Include="Serilog" Version="4.3.1" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.Seq" Version="9.0.0" />

    </ItemGroup>
</Project>